GEMINI_API_KEY=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Safety switch. Keep false until you have manually reviewed generated slides.
POST_TO_INSTAGRAM=false

# Choose how far one manual run should go: content, images, upload, or publish.
PIPELINE_PHASE=content

# Choose slide image generation method: local or gemini.
IMAGE_PROVIDER=local

# Optional overrides.
SLIDE_COUNT=5
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
INSTAGRAM_GRAPH_API_VERSION=v24.0
# Auto uses graph.instagram.com for IGA tokens and graph.facebook.com otherwise.
INSTAGRAM_GRAPH_HOST=auto
CAROUSEL_CAPTION=
